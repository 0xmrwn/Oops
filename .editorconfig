# Read by editors and by shfmt.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.py]
indent_style = space
indent_size = 4
